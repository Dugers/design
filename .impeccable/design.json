  "narrative": {
    "northStar": "The Editorial Catalogue",
    "overview": "An editorial catalogue for an independent design studio. Cool limestone, near-black typography and a rare vermilion signal frame the work. Oversized numerical typography supplies the identity; the rest of the interface is clear, quiet and precise.\n\nProject imagery carries its own color and material character. Unboxed compositions, thin rules and changing column widths create rhythm without decorative interface chrome. This system governs the studio homepage; the preserved story has its own authority in story/DESIGN.md.",
    "keyCharacteristics": [
      "Expressive numerical wordmark; restrained supporting typography.",
      "Unboxed project imagery and asymmetric desktop spreads.",
      "Flat surfaces, thin rules and clear interactive states.",
      "Responsive reflow and reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Work First Rule",
        "body": "Keep interface surfaces quiet enough for project imagery to carry the visual variety.",
        "section": "colors"
      },
      {
        "name": "The Identity Scale Rule",
        "body": "Reserve the largest Red Hat Display numerals for the studio identity; use Cantarell for readable content and controls.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use spacing, contrast and thin rules for separation. The implemented studio interface has no box shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the existing color variables and locally hosted font families.",
      "Do give project imagery generous space and place metadata below it.",
      "Do preserve visible keyboard focus and the selected filter underline.",
      "Do collapse the project grid to a single column on small screens.",
      "Do describe portfolio concepts honestly and keep the story’s visual system separate."
    ],
    "donts": [
      "Don't add rounded card shells or ambient shadows to the studio grid.",
      "Don't turn the vermilion accent into a large decorative background.",
      "Don't substitute the story’s handwritten fonts or dark palette into studio pages.",
      "Don't introduce motion that ignores the reduced-motion preference."
    ]
